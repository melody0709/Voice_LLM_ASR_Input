CompileFlags:
  Add:
    - --target=x86_64-pc-windows-msvc
    - -DUNICODE
    - -D_UNICODE
    - -Isrc
    - -Ithird_party/sherpa-onnx/include
    - -Ithird_party/onnxruntime/include
    - -Ithird_party/kaldi_native_fbank/include
  Compiler: cl
Diagnostics:
  Suppress:
    - clang-diagnostic-msvc-include
